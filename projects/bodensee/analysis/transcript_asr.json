[
 {
  "start": 0.12,
  "end": 5.42,
  "text": "Mitten in Europa liegt ein See, bei dem bis heute niemand weiß, wem er eigentlich gehört."
 },
 {
  "start": 5.88,
  "end": 7.08,
  "text": "Das ist der Bodensee."
 },
 {
  "start": 7.61,
  "end": 9.42,
  "text": "Drei Länder liegen an seinem Ufer."
 },
 {
  "start": 9.72,
  "end": 12.04,
  "text": "Deutschland, Österreich und die Schweiz."
 },
 {
  "start": 12.44,
  "end": 13.99,
  "text": "Aber eine Grenze im See?"
 },
 {
  "start": 14.3,
  "end": 14.92,
  "text": "gibt es nicht"
 },
 {
  "start": 15.36,
  "end": 16.27,
  "text": "Wie kann das sein?"
 },
 {
  "start": 16.83,
  "end": 18.22,
  "text": "Früher brauchte man keine."
 },
 {
  "start": 18.62,
  "end": 22.19,
  "text": "Rund um den See herrscht ein Fürsten, Klöster und Reichsstädte."
 },
 {
  "start": 22.46,
  "end": 25.1,
  "text": "alle unter dem Dach des heiligen römischen Reichs."
 },
 {
  "start": 25.47,
  "end": 27.11,
  "text": "Der See war einfach der See."
 },
 {
  "start": 27.61,
  "end": 29.77,
  "text": "Doch dann geht die Schweiz eigene Wege."
 },
 {
  "start": 30.11,
  "end": 31.27,
  "text": "Das Reich zerfällt."
 },
 {
  "start": 31.61,
  "end": 34.54,
  "text": "und plötzlich teilen sich mehrere Staaten das Ufer."
 },
 {
  "start": 34.94,
  "end": 38.95,
  "text": "Für den kleinen Untersee zieht man 1854 eine Grenze."
 },
 {
  "start": 39.32,
  "end": 40.65,
  "text": "Für den großen Obersee?"
 },
 {
  "start": 40.96,
  "end": 41.35,
  "text": "Ni."
 },
 {
  "start": 41.76,
  "end": 44.49,
  "text": "Und so hat heute jedes Land seine eigene Meinung."
 },
 {
  "start": 44.92,
  "end": 45.87,
  "text": "Die Schweiz sagt"
 },
 {
  "start": 46.11,
  "end": 46.76,
  "text": "Ganz klar!"
 },
 {
  "start": 46.97,
  "end": 49.16,
  "text": "Das Grenze geht genau in die Mitte durch."
 },
 {
  "start": 49.5,
  "end": 50.51,
  "text": "Österreich sagt"
 },
 {
  "start": 50.75,
  "end": 53.48,
  "text": "Geh bitte, der See gehört uns doch alle zusammen."
 },
 {
  "start": 53.88,
  "end": 54.73,
  "text": "und Deutschland?"
 },
 {
  "start": 55.13,
  "end": 58.54,
  "text": "Dazu können wir zum jetzigen Zeitpunkt leider keine Aussage treffen."
 },
 {
  "start": 58.97,
  "end": 59.82,
  "text": "Das Verrückte"
 },
 {
  "start": 60.06,
  "end": 61.45,
  "text": "Es funktioniert trotzdem."
 },
 {
  "start": 61.85,
  "end": 64.14,
  "text": "Fischerei, Schifffahrt, Wasserschutz."
 },
 {
  "start": 64.28,
  "end": 66.31,
  "text": "Alles regeln die drei Länder gemeinsam."
 },
 {
  "start": 66.72,
  "end": 68.91,
  "text": "Nur die eine Frage klären sie nie."
 },
 {
  "start": 69.21,
  "end": 71.91,
  "text": "Millionen Menschen trinken Wasser aus diesem See."
 },
 {
  "start": 72.22,
  "end": 73.86,
  "text": "Und trotzdem gilt bis heute"
 }
]