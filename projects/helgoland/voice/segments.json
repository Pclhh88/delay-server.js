[
 {
  "start": 0.09,
  "end": 4.84,
  "text": "Die Brieken zünden fast 7000 Tonnen Sprengstoff auf einer deutschen Insel."
 },
 {
  "start": 5.28,
  "end": 7.18,
  "text": "und die Insel bleibt einfach stehen."
 },
 {
  "start": 7.8,
  "end": 10.03,
  "text": "April 1947"
 },
 {
  "start": 10.27,
  "end": 12.33,
  "text": "Helgoland mitten in der Nordsee."
 },
 {
  "start": 12.76,
  "end": 14.38,
  "text": "Die Bewohner sind längst weg."
 },
 {
  "start": 14.72,
  "end": 17.64,
  "text": "In den Bunkern liegen die Rester eines ganzen Krieges."
 },
 {
  "start": 17.98,
  "end": 19.66,
  "text": "4000 Torpedo-Köpfe."
 },
 {
  "start": 19.84,
  "end": 21.39,
  "text": "9000 Wasserbomben"
 },
 {
  "start": 21.56,
  "end": 23.56,
  "text": "über 90.000 Granaten."
 },
 {
  "start": 24.03,
  "end": 26.03,
  "text": "Die Royal Navy verkabelt alles."
 },
 {
  "start": 26.24,
  "end": 28.62,
  "text": "Kilometer um Kilometer Zündkabel."
 },
 {
  "start": 28.89,
  "end": 30.99,
  "text": "Ein Schiff geht weit draußen in Stellung."
 },
 {
  "start": 31.36,
  "end": 33.83,
  "text": "Am 18. April, Punkt 13 Uhr"
 },
 {
  "start": 33.98,
  "end": 35.21,
  "text": "drückt jemand den Knopf."
 },
 {
  "start": 35.52,
  "end": 39.05,
  "text": "eine der größten nicht atomaren Explosionen der Geschichte."
 },
 {
  "start": 39.42,
  "end": 42.25,
  "text": "Als sich der Rauch verzieht, ist die Südspitze"
 },
 {
  "start": 42.52,
  "end": 43.79,
  "text": "Der Rest von Helgoland?"
 },
 {
  "start": 44.19,
  "end": 44.68,
  "text": "steht noch"
 },
 {
  "start": 45.15,
  "end": 45.9,
  "text": "und nennt mal"
 },
 {
  "start": 46.2,
  "end": 48.33,
  "text": "Wie überlebt ein Felsen so etwas?"
 },
 {
  "start": 48.6,
  "end": 49.26,
  "text": "der Grund"
 },
 {
  "start": 49.47,
  "end": 52.01,
  "text": "Helgoland ist aus rotem Buntsanstein."
 },
 {
  "start": 52.32,
  "end": 53.55,
  "text": "und der ist Porus."
 },
 {
  "start": 53.76,
  "end": 55.4,
  "text": "voller winziger Hohlräume"
 },
 {
  "start": 55.71,
  "end": 58.76,
  "text": "Wucht verpufft darin, statt den Felsen zu zerreiß"
 },
 {
  "start": 59.04,
  "end": 63.63,
  "text": "Wie wenn du mit voller Kraft in ein Sofa-Kissen schlägst, statt gegen eine Glasscheibe."
 },
 {
  "start": 64.03,
  "end": 65.55,
  "text": "Die Briten geben nicht auf."
 },
 {
  "start": 65.82,
  "end": 69.39,
  "text": "Jahrelang werfen ihre Flugzeuge Übungsbomben auf die Insel."
 },
 {
  "start": 69.66,
  "end": 77.16,
  "text": "Bis im Dezember 1950 zwei Studenten aus Heidelberg heimlich übersetzen, die Inse besetzen und Flagen hießen."
 },
 {
  "start": 77.47,
  "end": 80.27,
  "text": "Trotzlich redet ganz Deutschland über Helgoland."
 },
 {
  "start": 80.57,
  "end": 84.04,
  "text": "1952 bekommt Deutschland die Insel zurück."
 },
 {
  "start": 84.28,
  "end": 84.91,
  "text": "und heute"
 },
 {
  "start": 85.18,
  "end": 87.85,
  "text": "kommen jedes Jahr hunderttausende Touristen."
 },
 {
  "start": 88.09,
  "end": 90.76,
  "text": "um zollfrei Schnaps und Zigaretten zu kaufen."
 },
 {
  "start": 91.0,
  "end": 95.94,
  "text": "auf der Insel, die nicht mal 7.000 Tonnen Sprengstoff klein gekriegt haben."
 }
]