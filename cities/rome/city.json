  "beats": [
    {
      "id": "intro",
      "focus": "island",
      "shot": {
        "move": "overview_orbit"
      },
      "text": "Rom. 3000 Jahre Geschichte, vier Weltwunder und trotzdem findet hier niemand einen Parkplatz.",
      "sfx": [
