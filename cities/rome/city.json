      "pin": true,
      "actions": [
        "bounce"
      ],
      "shot": {
        "move": "push_in"
      },
      "text": "Das Kolosseum. Eröffnet im Jahr 80, Platz für 50.000 Zuschauer. Eintritt frei, Verpflegung inklusive. Nur das Programm war eher endgültig.",
      "sfx": [
        {
          "name": "pop",
          "at": 0.1
        }
      ],
      "emphasis": [
        "Kolosseum",
