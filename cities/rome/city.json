      ],
      "shot": {
        "move": "orbit",
        "az": [
          160,
          260
        ],
        "el": [
          26,
          34
        ]
      },
      "text": "Dass ein Teil fehlt, waren nicht die Barbaren. Die Römer haben es jahrhundertelang als Steinbruch benutzt. Recycling mit Ehrgeiz.",
      "sfx": [
        {
          "name": "swoosh_down",
          "at": 1.0
        }
      ],
      "emphasis": [
        "Steinbruch",
        "Ehrgeiz"
